# SmileRecall Environment Variables
# Copy to .env.local for local development

# 1. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Supabase Configuration (Leave blank or mock to test without live Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Security & Cron Secrets
# Secret key used to encrypt WhatsApp access tokens at rest (32 bytes)
ENCRYPTION_KEY=smile_recall_32_bytes_secure_key_prod_2026!
# Secret token required to trigger the 5-minute automation cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=smile_recall_cron_secret_auth_token_99

# 4. WhatsApp Cloud API (Meta) Configuration
# Set to 'true' to use the in-memory Mock Provider for local testing without Meta credentials
WHATSAPP_MOCK_MODE=true
WHATSAPP_API_VERSION=v19.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=smilerecall_meta_verify_token_2026
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# 5. Billing & Subscriptions (Phase 7 - Feature Flagged)
FEATURE_FLAG_BILLING=false
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
